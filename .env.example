# ── Server ───────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
# Comma-separated origins allowed to call the API, or * for any
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
MAX_FILE_SIZE=5242880

# ── Database / auth ──────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/otp_auth_db
# Use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me

# ── SMS OTP (2Factor) ────────────────────────────────────
TWO_FACTOR_API_KEY=
TWO_FACTOR_BASE_URL=https://2factor.in/API/V1

# ── Email (Gmail app password) ───────────────────────────
ADMIN_EMAIL=
ADMIN_PASS=

# ── Google Maps ──────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Razorpay (key id/secret are stored in admin Settings) ─
RAZORPAY_WEBHOOK_SECRET=

# ── Backups (requires `mongodump` on PATH) ───────────────
BACKUP_API_URL=
BACKUP_API_KEY=
MAX_BACKUP_SIZE_MB=25
BACKUP_RETENTION_DAYS=0
SITE_NAME=Meenavan

# ── Cloudflare R2 (image storage) ────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
